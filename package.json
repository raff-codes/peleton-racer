{
  "name": "peleton-racer",
  "version": "0.1.0",
  "description": "An unofficial 3D racing game for the Peloton Bike and Bike+ tablet",
  "license": "GPL-3.0-only",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "dev": "expo run:android --device",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android",
    "build:apk": "expo prebuild --platform android && cd android && ./gradlew assembleRelease",
    "install:bike": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "logs:sensors": "adb logcat -s PelotonSensors",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "expo": "~58.0.20",
    "expo-asset": "~58.0.18",
    "expo-build-properties": "~58.0.11",
    "expo-dev-client": "~58.0.16",
    "expo-file-system": "~58.0.12",
    "expo-gl": "~58.0.3",
    "expo-keep-awake": "~58.0.3",
    "expo-navigation-bar": "~58.0.4",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "three": "^0.186.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/react": "~19.3.0",
    "@types/three": "^0.186.0",
    "typescript": "~6.0.3"
  }
}
